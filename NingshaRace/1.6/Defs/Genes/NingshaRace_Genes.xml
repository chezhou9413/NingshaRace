<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 文件职责：定义凝砂族异种人使用的专属基因分类和七项种族基因。 -->
  <GeneCategoryDef>
    <defName>NingshaRace_GeneCategory</defName>
    <label>凝砂族</label>
    <displayPriorityInXenotype>505</displayPriorityInXenotype>
  </GeneCategoryDef>

  <!-- 基因基类职责：统一凝砂族专属基因的分类与基础生物统计。 -->
  <GeneDef Name="NingshaRace_GeneBase" Abstract="True">
    <displayCategory>NingshaRace_GeneCategory</displayCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>0</biostatMet>
  </GeneDef>

  <GeneDef ParentName="NingshaRace_GeneBase">
    <defName>NingshaRace_VenomFangs</defName>
    <label>毒牙</label>
    <labelShortAdj>毒牙</labelShortAdj>
    <description>携带者的毒牙会在近战命中时向活体血肉目标注入石化砂质。每次成功命中有50%的概率增加5%石化进度。</description>
    <iconPath>UI/Icons/Genes/NingshaRace/VenomFangs</iconPath>
    <displayOrderInCategory>10</displayOrderInCategory>
    <customEffectDescriptions>
      <li>成功近战命中时有50%概率增加5%石化进度。</li>
    </customEffectDescriptions>
  </GeneDef>

  <GeneDef ParentName="NingshaRace_GeneBase">
    <defName>NingshaRace_ScaledSkin</defName>
    <label>鳞片皮肤</label>
    <labelShortAdj>鳞皮</labelShortAdj>
    <description>携带者的皮肤由坚韧而灵活的细密鳞片覆盖，能够显著减轻伤害并帮助身体避开近战攻击。</description>
    <iconPath>UI/Icons/Genes/NingshaRace/ScaledSkin</iconPath>
    <displayOrderInCategory>20</displayOrderInCategory>
    <statFactors>
      <IncomingDamageFactor>0.6</IncomingDamageFactor>
    </statFactors>
    <statOffsets>
      <MeleeDodgeChance>0.06</MeleeDodgeChance>
    </statOffsets>
  </GeneDef>

  <GeneDef ParentName="NingshaRace_GeneBase">
    <defName>NingshaRace_DesertAdaptation</defName>
    <label>沙漠适应</label>
    <labelShortAdj>沙漠适应</labelShortAdj>
    <description>携带者适应了沙漠与黑夜中的行动。在夜间，或身处沙漠、极端沙漠及沙漠巨坑时，工作与移动效率都会提高。</description>
    <iconPath>UI/Icons/Genes/NingshaRace/DesertAdaptation</iconPath>
    <displayOrderInCategory>30</displayOrderInCategory>
    <conditionalStatAffecters>
      <li Class="NingshaRaceLib.Genes.Conditions.ConditionalStatAffecter_NingshaDesertAdaptation">
        <statFactors>
          <WorkSpeedGlobal>1.2</WorkSpeedGlobal>
          <MoveSpeed>1.1</MoveSpeed>
        </statFactors>
      </li>
    </conditionalStatAffecters>
  </GeneDef>

  <GeneDef ParentName="NingshaRace_GeneBase">
    <defName>NingshaRace_ColdBlooded</defName>
    <label>冷血</label>
    <labelShortAdj>冷血</labelShortAdj>
    <description>携带者更依赖温暖环境，同时能够承受更高温度，但冷淡的体温与情绪会削弱社交影响力。</description>
    <iconPath>UI/Icons/Genes/NingshaRace/ColdBlooded</iconPath>
    <displayOrderInCategory>40</displayOrderInCategory>
    <statOffsets>
      <ComfyTemperatureMin>10</ComfyTemperatureMin>
      <ComfyTemperatureMax>20</ComfyTemperatureMax>
    </statOffsets>
    <statFactors>
      <SocialImpact>0.85</SocialImpact>
    </statFactors>
  </GeneDef>

  <GeneDef ParentName="NingshaRace_GeneBase">
    <defName>NingshaRace_HeatSense</defName>
    <label>热感知</label>
    <labelShortAdj>热感知</labelShortAdj>
    <description>携带者能够通过环境中的细微热量变化识别目标，从而改善视觉、射击精度和瞄准速度。</description>
    <iconPath>UI/Icons/Genes/NingshaRace/HeatSense</iconPath>
    <displayOrderInCategory>50</displayOrderInCategory>
    <capMods>
      <li>
        <capacity>Sight</capacity>
        <postFactor>1.2</postFactor>
      </li>
    </capMods>
    <statOffsets>
      <ShootingAccuracyPawn>3</ShootingAccuracyPawn>
    </statOffsets>
    <statFactors>
      <AimingDelayFactor>0.8</AimingDelayFactor>
    </statFactors>
  </GeneDef>

  <GeneDef ParentName="NingshaRace_GeneBase">
    <defName>NingshaRace_ErosionTolerance</defName>
    <label>侵蚀耐受</label>
    <labelShortAdj>耐蚀</labelShortAdj>
    <description>携带者的身体能够容纳更多侵蚀力量，使侵蚀值上限提高20%。</description>
    <iconPath>UI/Icons/Genes/NingshaRace/ErosionTolerance</iconPath>
    <displayOrderInCategory>60</displayOrderInCategory>
    <statFactors>
      <NingshaRace_ErosionLimit>1.2</NingshaRace_ErosionLimit>
    </statFactors>
  </GeneDef>

  <GeneDef ParentName="NingshaRace_GeneBase">
    <defName>NingshaRace_Cannibalism</defName>
    <label>同类相食</label>
    <labelShortAdj>食人</labelShortAdj>
    <description>携带者不会因直接食用人肉或食用含人肉配料的食物而产生负面心情。直接食用新鲜生肉时，她们反而会因血肉的原始滋味而感到愉悦。</description>
    <iconPath>UI/Icons/Genes/NingshaRace/Cannibalism</iconPath>
    <displayOrderInCategory>70</displayOrderInCategory>
    <customEffectDescriptions>
      <li>免疫由食用人肉产生的负面思想。</li>
      <li>直接食用生肉时不会产生生食惩罚，并获得正面心情。</li>
    </customEffectDescriptions>
  </GeneDef>
</Defs>
