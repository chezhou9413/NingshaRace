<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 文件职责：定义凝砂族沙漠地底开局使用的固定场景部件。 -->

  <!-- Def 职责：配置三名必选凝砂族及备用候选人的种族和异种生成规则。 -->
  <ScenPartDef>
    <defName>NingshaRace_StartingPawns</defName>
    <label>凝砂族开局成员</label>
    <scenPartClass>NingshaRaceLib.Scenarios.Parts.ScenPart_NingshaStartingPawns</scenPartClass>
    <pageClass>Page_ConfigureStartingPawns</pageClass>
    <category>Fixed</category>
    <summaryPriority>500</summaryPriority>
    <selectionWeight>0</selectionWeight>
    <canBeRandomlyAdded>false</canBeRandomlyAdded>
    <canBePlayerAddedRemoved>false</canBePlayerAddedRemoved>
  </ScenPartDef>

  <!-- Def 职责：跳过手动选址并把地表入口固定到沙漠世界格。 -->
  <ScenPartDef>
    <defName>NingshaRace_ForcedDesertPitStart</defName>
    <label>沙漠地底出生地</label>
    <description>殖民地会自动建立在随机沙漠区域的地下。</description>
    <category>Fixed</category>
    <scenPartClass>NingshaRaceLib.Scenarios.Parts.ScenPart_ForcedDesertPitStart</scenPartClass>
    <summaryPriority>480</summaryPriority>
    <selectionWeight>0</selectionWeight>
    <canBeRandomlyAdded>false</canBeRandomlyAdded>
    <canBePlayerAddedRemoved>false</canBePlayerAddedRemoved>
  </ScenPartDef>

  <!-- Def 职责：在地表生成完成后建立地下家园，直接安置成员和物资。 -->
  <ScenPartDef>
    <defName>NingshaRace_UndergroundArrival</defName>
    <label>在巨坑内安家</label>
    <scenPartClass>NingshaRaceLib.Scenarios.Parts.ScenPart_NingshaUndergroundArrival</scenPartClass>
    <category>Fixed</category>
    <selectionWeight>0</selectionWeight>
    <canBeRandomlyAdded>false</canBeRandomlyAdded>
    <canBePlayerAddedRemoved>false</canBePlayerAddedRemoved>
  </ScenPartDef>

  <!-- Def 职责：为三名凝砂族开局成员分别装备一件专属武器。 -->
  <ScenPartDef>
    <defName>NingshaRace_StartingEquipment</defName>
    <label>凝砂族开局装备</label>
    <description>三名凝砂族分别携带蛇腹剑、飞针和沙瓶。</description>
    <category>Fixed</category>
    <scenPartClass>NingshaRaceLib.Scenarios.Parts.ScenPart_NingshaStartingEquipment</scenPartClass>
    <summaryPriority>450</summaryPriority>
    <selectionWeight>0</selectionWeight>
    <canBeRandomlyAdded>false</canBeRandomlyAdded>
    <canBePlayerAddedRemoved>false</canBePlayerAddedRemoved>
  </ScenPartDef>
</Defs>
