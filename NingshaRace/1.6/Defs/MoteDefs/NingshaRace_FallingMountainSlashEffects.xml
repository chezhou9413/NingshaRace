<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 文件职责：定义坠岳斩使用的 PawnFlyer、程序化月牙刀光和落地地裂 Mote。 -->

  <!-- Def 职责：承载施术者飞向目标并在挥刀节点结算攻击。 -->
  <ThingDef ParentName="PawnFlyerBase">
    <defName>NingshaRace_PawnFlyer_FallingMountainSlash</defName>
    <label>坠岳斩飞行</label>
    <thingClass>NingshaRaceLib.Combat.PawnFlyer_FallingMountainSlash</thingClass>
    <pawnFlyer>
      <flightDurationMin>0.4</flightDurationMin>
      <flightSpeed>15</flightSpeed>
      <heightFactor>1</heightFactor>
    </pawnFlyer>
  </ThingDef>

  <!-- Def 职责：在坠岳斩落点短暂显示单张透明地裂贴图。 -->
  <ThingDef ParentName="MoteBase">
    <defName>NingshaRace_Mote_FallingMountainGroundCrack</defName>
    <label>坠岳斩地裂</label>
    <thingClass>MoteThrown</thingClass>
    <altitudeLayer>MoteLow</altitudeLayer>
    <graphicData>
      <texPath>NingshaRace/Effects/BurialMountainGroundCrack</texPath>
      <graphicClass>Graphic_Mote</graphicClass>
      <shaderType>Mote</shaderType>
      <drawSize>(5.8,5.8)</drawSize>
    </graphicData>
    <mote>
      <fadeInTime>0.05</fadeInTime>
      <solidTime>0.55</solidTime>
      <fadeOutTime>0.35</fadeOutTime>
    </mote>
  </ThingDef>

  <!-- Def 职责：使用土元素月牙 Shader 播放展开、保持和收束时间轴。 -->
  <ThingDef ParentName="MoteBase">
    <defName>NingshaRace_Mote_TerraCrescentSlash</defName>
    <label>土元素月牙刀光</label>
    <thingClass>NingshaRaceLib.Rendering.Mote_TerraCrescentSlash</thingClass>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <graphicData>
      <texPath>UI/Misc/BadTexture</texPath>
      <graphicClass>Graphic_Mote</graphicClass>
      <shaderType>NingshaRace_TerraCrescentSlash_ShaderPro</shaderType>
      <drawSize>(5,5)</drawSize>
    </graphicData>
    <mote>
      <fadeInTime>0</fadeInTime>
      <solidTime>0.9</solidTime>
      <fadeOutTime>0</fadeOutTime>
    </mote>
  </ThingDef>

  <!-- Def 职责：在葬岳格挡模式开启时跟随持剑者显示菲涅尔护盾。 -->
  <ThingDef ParentName="MoteBase">
    <defName>NingshaRace_Mote_BurialMountainGuardShield</defName>
    <label>葬岳菲涅尔护盾</label>
    <thingClass>NingshaRaceLib.Rendering.Mote_BurialMountainGuardShield</thingClass>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <graphicData>
      <texPath>UI/Misc/BadTexture</texPath>
      <graphicClass>Graphic_Mote</graphicClass>
      <shaderType>NingshaRace_BurialMountainGuardShield_ShaderPro</shaderType>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <mote>
      <fadeInTime>0.12</fadeInTime>
      <solidTime>999999</solidTime>
      <fadeOutTime>0.18</fadeOutTime>
      <needsMaintenance>true</needsMaintenance>
      <fadeOutUnmaintained>true</fadeOutUnmaintained>
    </mote>
  </ThingDef>

  <!-- Def 职责：在葬岳格挡蓄满释放时显示沙土爆发冲击环。 -->
  <ThingDef ParentName="MoteBase">
    <defName>NingshaRace_Mote_BurialMountainGuardBurst</defName>
    <label>葬岳格挡爆发</label>
    <thingClass>NingshaRaceLib.Rendering.Mote_BurialMountainGuardBurst</thingClass>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <graphicData>
      <texPath>UI/Misc/BadTexture</texPath>
      <graphicClass>Graphic_Mote</graphicClass>
      <shaderType>NingshaRace_BurialMountainGuardBurst_ShaderPro</shaderType>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <mote>
      <fadeInTime>0</fadeInTime>
      <solidTime>0.45</solidTime>
      <fadeOutTime>0.2</fadeOutTime>
    </mote>
  </ThingDef>
</Defs>
