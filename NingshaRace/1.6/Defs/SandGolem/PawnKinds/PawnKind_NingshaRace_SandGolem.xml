<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 文件职责：定义沙傀专用 PawnKind。 -->
  <PawnKindDef>
    <defName>NingshaRace_SandGolemKind</defName>
    <label>沙傀</label>
    <race>NingshaRace_SandGolem</race>
    <defaultFactionDef>PlayerColony</defaultFactionDef>
    <aiAvoidCover>false</aiAvoidCover>
    <combatPower>20</combatPower>
    <apparelMoney>0~0</apparelMoney>
    <apparelTags />
    <apparelRequired Inherit="False" />
    <weaponMoney>0~0</weaponMoney>
    <weaponTags />
    <techHediffsChance>0</techHediffsChance>
    <chemicalAddictionChance>0</chemicalAddictionChance>
    <backstoryCryptosleepCommonality>0</backstoryCryptosleepCommonality>
    <initialResistanceRange>0~0</initialResistanceRange>
    <initialWillRange>0~0</initialWillRange>
    <isFighter>false</isFighter>
    <!-- 沙傀由召唤工厂直接生成，不参与事件和战斗群组的候选选择。 -->
    <allowInMechClusters>false</allowInMechClusters>
    <appearsRandomlyInCombatGroups>false</appearsRandomlyInCombatGroups>
    <maxPerGroup>0</maxPerGroup>
    <canArriveManhunter>false</canArriveManhunter>
    <canBeScattered>false</canBeScattered>
    <destroyGearOnDrop>true</destroyGearOnDrop>
    <canStrip>false</canStrip>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Humanlike/Silhouettes/Silhouette_HumanAdult</texPath>
          <shaderType>Cutout</shaderType>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.5</drawSize>
          <shadowData>
            <volume>(0.3, 0.5, 0.3)</volume>
            <offset>(0, 0, -0.3)</offset>
          </shadowData>
        </bodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>
</Defs>
