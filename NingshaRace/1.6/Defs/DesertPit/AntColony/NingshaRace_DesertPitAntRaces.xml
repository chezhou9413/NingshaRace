<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 文件职责：定义沙漠巨坑蚁后、工蚁、兵蚁和爆浆蚁的种族与生成种类。 -->
  <ThingDef ParentName="BaseInsect">
    <defName>NingshaRace_DesertPitWorkerAnt</defName>
    <label>洞穴工蚁</label>
    <description>负责搜寻食物和贵重物资并搬回地下蚁穴的工蚁。它不擅长正面战斗，受到威胁时会优先退回巢群。</description>
    <uiIconScale>1.2</uiIconScale>
    <statBases>
      <MoveSpeed>4.2</MoveSpeed>
      <ArmorRating_Blunt>0.12</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.18</ArmorRating_Sharp>
      <ComfyTemperatureMin>-15</ComfyTemperatureMin>
      <MarketValue>90</MarketValue>
      <LeatherAmount>0</LeatherAmount>
      <Wildness>1</Wildness>
    </statBases>
    <tools>
      <li>
        <label>颚齿</label>
        <capacities><li>Bite</li></capacities>
        <power>4</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
      </li>
    </tools>
    <race>
      <thinkTreeMain>NingshaRace_DesertPitAnt</thinkTreeMain>
      <thinkTreeConstant>NingshaRace_DesertPitAntConstant</thinkTreeConstant>
      <body>BeetleLike</body>
      <baseBodySize>0.8</baseBodySize>
      <baseHungerRate>0.18</baseHungerRate>
      <baseHealthScale>1.2</baseHealthScale>
      <useMeatFrom>Megaspider</useMeatFrom>
      <lifeExpectancy>6</lifeExpectancy>
      <trainability>None</trainability>
      <lifeStageAges>
        <li>
          <def>EusocialInsectAdult</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_Spelopede_Pain</soundWounded>
          <soundDeath>Pawn_Spelopede_Death</soundDeath>
          <soundCall>Pawn_Spelopede_Call</soundCall>
          <soundAngry>Pawn_Spelopede_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <comps>
      <li Class="NingshaRaceLib.DesertPit.AntColony.Components.CompProperties_DesertPitAntMember">
        <caste>Worker</caste>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BaseInsect">
    <defName>NingshaRace_DesertPitSoldierAnt</defName>
    <label>洞穴兵蚁</label>
    <description>围绕地下蚁穴巡逻的大型兵蚁，会拦截任何进入领地的外来生物。</description>
    <uiIconScale>1.1</uiIconScale>
    <statBases>
      <MoveSpeed>3.8</MoveSpeed>
      <ArmorRating_Blunt>0.2</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.28</ArmorRating_Sharp>
      <ComfyTemperatureMin>-20</ComfyTemperatureMin>
      <MarketValue>210</MarketValue>
      <LeatherAmount>0</LeatherAmount>
      <Wildness>1</Wildness>
    </statBases>
    <tools>
      <li>
        <label>战斗颚</label>
        <capacities><li>Cut</li></capacities>
        <power>10</power>
        <cooldownTime>2.2</cooldownTime>
        <linkedBodyPartsGroup>HeadClaw</linkedBodyPartsGroup>
      </li>
    </tools>
    <race>
      <thinkTreeMain>NingshaRace_DesertPitAnt</thinkTreeMain>
      <thinkTreeConstant>NingshaRace_DesertPitAntConstant</thinkTreeConstant>
      <body>BeetleLikeWithClaw</body>
      <baseBodySize>1.2</baseBodySize>
      <baseHungerRate>0.24</baseHungerRate>
      <baseHealthScale>2.2</baseHealthScale>
      <useMeatFrom>Megaspider</useMeatFrom>
      <lifeExpectancy>7</lifeExpectancy>
      <trainability>None</trainability>
      <lifeStageAges>
        <li>
          <def>EusocialInsectAdult</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_BigInsect_Pain</soundWounded>
          <soundDeath>Pawn_BigInsect_Death</soundDeath>
          <soundCall>Pawn_BigInsect_Call</soundCall>
          <soundAngry>Pawn_BigInsect_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
    </race>
    <comps>
      <li Class="NingshaRaceLib.DesertPit.AntColony.Components.CompProperties_DesertPitAntMember">
        <caste>Soldier</caste>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BaseInsect">
    <defName>NingshaRace_DesertPitQueenAnt</defName>
    <label>洞穴蚁后</label>
    <description>维持整个地下巢群的蚁后。它会消耗蚁穴储备的食物，直接补充死亡的工蚁和兵蚁。</description>
    <uiIconScale>0.85</uiIconScale>
    <statBases>
      <MoveSpeed>2.4</MoveSpeed>
      <ArmorRating_Blunt>0.24</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.32</ArmorRating_Sharp>
      <ComfyTemperatureMin>-20</ComfyTemperatureMin>
      <MarketValue>650</MarketValue>
      <LeatherAmount>0</LeatherAmount>
      <Wildness>1</Wildness>
    </statBases>
    <tools>
      <li>
        <label>蚁后巨颚</label>
        <capacities><li>Cut</li></capacities>
        <power>12</power>
        <cooldownTime>2.8</cooldownTime>
        <linkedBodyPartsGroup>HeadClaw</linkedBodyPartsGroup>
      </li>
    </tools>
    <race>
      <thinkTreeMain>NingshaRace_DesertPitAnt</thinkTreeMain>
      <thinkTreeConstant>NingshaRace_DesertPitAntConstant</thinkTreeConstant>
      <body>BeetleLikeWithClaw</body>
      <baseBodySize>2</baseBodySize>
      <baseHungerRate>0.3</baseHungerRate>
      <baseHealthScale>3.5</baseHealthScale>
      <useMeatFrom>Megaspider</useMeatFrom>
      <lifeExpectancy>12</lifeExpectancy>
      <trainability>None</trainability>
      <lifeStageAges>
        <li>
          <def>EusocialInsectAdult</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_BigInsect_Pain</soundWounded>
          <soundDeath>Pawn_BigInsect_Death</soundDeath>
          <soundCall>Pawn_BigInsect_Call</soundCall>
          <soundAngry>Pawn_BigInsect_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
    </race>
    <comps>
      <li Class="NingshaRaceLib.DesertPit.AntColony.Components.CompProperties_DesertPitAntMember">
        <caste>Queen</caste>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BaseInsect">
    <defName>NingshaRace_DesertPitBoomAnt</defName>
    <label>爆浆蚁</label>
    <description>腹部积蓄着高压酸液的防御蚁。蚁穴受袭时它会扑向入侵者，并在接近或死亡时爆裂。</description>
    <thingClass>NingshaRaceLib.DesertPit.AntColony.Pawns.Pawn_DesertPitBoomAnt</thingClass>
    <uiIconScale>1.15</uiIconScale>
    <statBases>
      <MoveSpeed>5</MoveSpeed>
      <ArmorRating_Blunt>0.08</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.12</ArmorRating_Sharp>
      <ComfyTemperatureMin>-10</ComfyTemperatureMin>
      <MarketValue>110</MarketValue>
      <LeatherAmount>0</LeatherAmount>
      <Wildness>1</Wildness>
    </statBases>
    <tools>
      <li>
        <label>小颚</label>
        <capacities><li>Bite</li></capacities>
        <power>3</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
      </li>
    </tools>
    <race>
      <thinkTreeMain>NingshaRace_DesertPitAnt</thinkTreeMain>
      <thinkTreeConstant>NingshaRace_DesertPitAntConstant</thinkTreeConstant>
      <body>BeetleLike</body>
      <baseBodySize>0.6</baseBodySize>
      <baseHungerRate>0.1</baseHungerRate>
      <baseHealthScale>0.8</baseHealthScale>
      <useMeatFrom>Megaspider</useMeatFrom>
      <lifeExpectancy>4</lifeExpectancy>
      <trainability>None</trainability>
      <lifeStageAges>
        <li>
          <def>EusocialInsectAdult</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_Megascarab_Wounded</soundWounded>
          <soundDeath>Pawn_Megascarab_Death</soundDeath>
          <soundCall>Pawn_Megascarab_Call</soundCall>
          <soundAngry>Pawn_Megascarab_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <comps>
      <li Class="NingshaRaceLib.DesertPit.AntColony.Components.CompProperties_DesertPitAntMember">
        <caste>Boom</caste>
      </li>
    </comps>
  </ThingDef>

