<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 文件职责：定义沙漠巨坑巢群的可攻击蚁穴建筑和可调行为参数。 -->
  <ThingDef ParentName="BuildingBase" Name="NingshaRace_DesertPitAntNestBase">
    <defName>NingshaRace_DesertPitAntNest</defName>
    <label>洞穴蚁穴</label>
    <description>由压实沙土、唾液和有机残渣构成的大型地下蚁穴，是整个巢群的食物储藏与繁衍核心。</description>
    <thingClass>NingshaRaceLib.DesertPit.AntColony.Buildings.Building_DesertPitAntNest</thingClass>
    <category>Building</category>
    <drawerType>MapMeshOnly</drawerType>
    <altitudeLayer>Building</altitudeLayer>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/NingshaRace/DesertPit/AntColony/AntNest</texPath>
      <drawSize>(5.2,5.2)</drawSize>
      <shadowData>
        <volume>(3.6,1.3,3.6)</volume>
        <offset>(0,0,-0.3)</offset>
      </shadowData>
    </graphicData>
    <size>(4,4)</size>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <passability>Impassable</passability>
    <fillPercent>0.9</fillPercent>
    <pathCost>70</pathCost>
    <destroyable>true</destroyable>
    <useHitPoints>true</useHitPoints>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <filthLeaving>Filth_RubbleBuilding</filthLeaving>
    <soundImpactDefault>BulletImpact_Ground</soundImpactDefault>
    <statBases>
      <MaxHitPoints>1200</MaxHitPoints>
      <Flammability>0.3</Flammability>
      <MarketValue>300</MarketValue>
      <Beauty>-8</Beauty>
    </statBases>
    <building>
      <isEdifice>true</isEdifice>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
      <isTargetable>true</isTargetable>
      <expandHomeArea>false</expandHomeArea>
    </building>
    <modExtensions>
      <li Class="NingshaRaceLib.DesertPit.AntColony.Config.DefModExtension_AntColony">
        <workerTarget>4</workerTarget>
        <soldierTarget>3</soldierTarget>
        <initialLevelMin>1</initialLevelMin>
        <initialLevelMax>3</initialLevelMax>
        <maximumLevelMin>3</maximumLevelMin>
        <maximumLevelMax>5</maximumLevelMax>
        <level2Nutrition>10</level2Nutrition>
        <level3Nutrition>50</level3Nutrition>
        <level4Nutrition>100</level4Nutrition>
        <level5Nutrition>500</level5Nutrition>
        <upgradeCooldownTicks>420000</upgradeCooldownTicks>
        <repairDelayAfterDamageTicks>2500</repairDelayAfterDamageTicks>
        <repairIntervalTicks>2500</repairIntervalTicks>
        <repairNutritionCost>1</repairNutritionCost>
        <repairHitPoints>100</repairHitPoints>
        <boomAntCap>3</boomAntCap>
        <storageCellCount>12</storageCellCount>
        <secondColonyChance>0.45</secondColonyChance>
        <alertRadius>20</alertRadius>
        <soldierPatrolRadius>12</soldierPatrolRadius>
        <workerWanderRadius>8</workerWanderRadius>
        <queenLeashRadius>5</queenLeashRadius>
        <workerRetreatRadius>8</workerRetreatRadius>
        <frenzyRadius>40</frenzyRadius>
        <retreatDefenseRadius>6</retreatDefenseRadius>
        <retreatLossWindowTicks>10000</retreatLossWindowTicks>
        <retreatDurationTicks>10000</retreatDurationTicks>
        <retreatLossFraction>0.5</retreatLossFraction>
        <investigationLossWindowTicks>60000</investigationLossWindowTicks>
        <investigationHotspotRadius>10</investigationHotspotRadius>
        <investigationLossFraction>0.2</investigationLossFraction>
        <investigationMinimumDeaths>3</investigationMinimumDeaths>
        <investigationCooldownTicks>60000</investigationCooldownTicks>
        <investigationRallyTimeoutTicks>2500</investigationRallyTimeoutTicks>
        <investigationTravelTimeoutTicks>10000</investigationTravelTimeoutTicks>
        <investigationDefendTicks>2500</investigationDefendTicks>
        <investigationMaxSquadSize>6</investigationMaxSquadSize>
        <workerHaulLimit>3</workerHaulLimit>
        <workerHaulCooldownTicks>2500</workerHaulCooldownTicks>
        <reproductionWorkTicks>600</reproductionWorkTicks>
        <reproductionCooldownTicks>2500</reproductionCooldownTicks>
        <workerNutritionCost>1</workerNutritionCost>
        <soldierNutritionCost>1.5</soldierNutritionCost>
        <fullAlarmDurationTicks>2500</fullAlarmDurationTicks>
        <boomWaveCooldownTicks>1200</boomWaveCooldownTicks>
        <boomTriggerDistance>1.5</boomTriggerDistance>
        <boomExplosionRadius>2.5</boomExplosionRadius>
        <boomExplosionDamage>25</boomExplosionDamage>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="NingshaRace_DesertPitAntNestBase">
    <defName>NingshaRace_GiantTombAntNest</defName>
    <label>墓穴洞穴蚁穴</label>
    <description>占据墓葬储藏室的小型洞穴蚁穴，仍维持着完整的采集、储藏、繁殖和防御行为。</description>
    <size>(3,3)</size>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/NingshaRace/DesertPit/AntColony/AntNest</texPath>
      <drawSize>(4.1,4.1)</drawSize>
      <shadowData>
        <volume>(2.8,1.1,2.8)</volume>
        <offset>(0,0,-0.2)</offset>
      </shadowData>
    </graphicData>
  </ThingDef>
</Defs>
