<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--文件职责：定义适应地下明暗环境的两种单株巨菇，复用原版植物生长和采收。-->
  <ThingDef Name="NingshaRace_GiantFungusBase" ParentName="TreeBase" Abstract="True">
    <thingClass>Plant</thingClass>
    <size>(1,1)</size>
    <neverMultiSelect>false</neverMultiSelect>
    <minifiedDef IsNull="True" />
    <fillPercent>0.3</fillPercent>
    <pathCost>30</pathCost>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.5,1.5)</drawSize>
      <addTopAltitudeBias>true</addTopAltitudeBias>
    </graphicData>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <Beauty>3</Beauty>
      <BeautyOutdoors>3</BeautyOutdoors>
    </statBases>
    <plant>
      <fertilityMin>0.01</fertilityMin>
      <fertilitySensitivity>0.15</fertilitySensitivity>
      <growMinGlow>0</growMinGlow>
      <growOptimalGlow>0</growOptimalGlow>
      <dieIfNoSunlight>false</dieIfNoSunlight>
      <diesToLight>false</diesToLight>
      <cavePlant>true</cavePlant>
      <neverBlightable>true</neverBlightable>
      <interferesWithRoof>false</interferesWithRoof>
      <forceIsTree>true</forceIsTree>
      <treeLoversCareIfChopped>false</treeLoversCareIfChopped>
      <burnedThingDef IsNull="True" />
      <choppedThingDef IsNull="True" />
      <smashedThingDef IsNull="True" />
      <sowTags Inherit="False" />
      <sowResearchPrerequisites Inherit="False" />
      <wildClusterWeight>0</wildClusterWeight>
      <visualSizeRange>0.75~2</visualSizeRange>
      <topWindExposure>0.04</topWindExposure>
      <pollution>Any</pollution>
    </plant>
  </ThingDef>

  <ThingDef ParentName="NingshaRace_GiantFungusBase">
    <defName>NingshaRace_GiantTimberMushroom</defName>
    <label>巨木伞菇</label>
    <description>生长在地下洞室中的巨型木质真菌。厚实的菌柄和菌盖富含坚韧纤维，成熟后可以砍伐取得木材。它不依赖阳光，也能耐受洞中的天光。</description>
    <graphicData>
      <texPath>Things/Plant/NingshaRace/DesertPit/GiantTimberMushroom</texPath>
    </graphicData>
    <plant>
      <growDays>20</growDays>
      <harvestedThingDef>WoodLog</harvestedThingDef>
      <harvestTag>Wood</harvestTag>
      <harvestYield>25</harvestYield>
      <harvestWork>800</harvestWork>
      <harvestMinGrowth>0.4</harvestMinGrowth>
      <harvestAfterGrowth>0</harvestAfterGrowth>
    </plant>
  </ThingDef>

  <ThingDef ParentName="NingshaRace_GiantFungusBase">
    <defName>NingshaRace_DroopingGlowMushroom</defName>
    <label>坠萤巨伞菇</label>
    <description>高大的地下巨菇，菌盖下垂挂着散发黄绿微光的坠萤果。果实可以采摘食用，采果后菌体仍会继续生长并再次结果。它适应无光洞室，也能耐受天光。</description>
    <graphicData>
      <texPath>Things/Plant/NingshaRace/DesertPit/DroopingGlowMushroom</texPath>
      <drawSize>(1.45,1.45)</drawSize>
    </graphicData>
    <statBases>
      <Beauty>5</Beauty>
      <BeautyOutdoors>5</BeautyOutdoors>
    </statBases>
    <plant>
      <growDays>12</growDays>
      <harvestedThingDef>NingshaRace_DroopingGlowFruit</harvestedThingDef>
      <harvestTag>Standard</harvestTag>
      <harvestYield>12</harvestYield>
      <harvestWork>350</harvestWork>
      <harvestMinGrowth>0.85</harvestMinGrowth>
      <harvestAfterGrowth>0.45</harvestAfterGrowth>
      <harvestFailable>true</harvestFailable>
      <soundHarvesting>Harvest_Standard</soundHarvesting>
      <soundHarvestFinish>Harvest_Standard_Finish</soundHarvestFinish>
      <purpose>Food</purpose>
      <humanFoodPlant>true</humanFoodPlant>
    </plant>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>6</glowRadius>
        <glowColor>(126,160,56,0)</glowColor>
      </li>
    </comps>
  </ThingDef>
</Defs>
