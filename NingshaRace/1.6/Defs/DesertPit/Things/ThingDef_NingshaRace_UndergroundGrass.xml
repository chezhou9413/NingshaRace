<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--复用原版草丛外观，定义生态水潭岸边需要半光照的地下草本。-->
  <ThingDef ParentName="PlantBase">
    <defName>NingshaRace_UndergroundGrass</defName>
    <label>地下草</label>
    <description>环绕地下水潭生长的草本，在天光裂隙或人工照明提供至少百分之五十的光照时生长。</description>
    <statBases><MaxHitPoints>85</MaxHitPoints><Flammability>1.3</Flammability><Nutrition>0.5</Nutrition></statBases>
    <graphicData><texPath>Things/Plant/Grass</texPath><graphicClass>Graphic_Random</graphicClass></graphicData>
    <hideAtSnowOrSandDepth>0.5</hideAtSnowOrSandDepth>
    <ingestible />
    <plant>
      <fertilityMin>0.05</fertilityMin>
      <fertilitySensitivity>0.3</fertilitySensitivity>
      <growDays>2.5</growDays>
      <growMinGlow>0.5</growMinGlow>
      <growOptimalGlow>0.5</growOptimalGlow>
      <dieIfNoSunlight>false</dieIfNoSunlight>
      <interferesWithRoof>false</interferesWithRoof>
      <leaflessGraphicPath>Things/Plant/Grass_Leafless</leaflessGraphicPath>
      <harvestWork>40</harvestWork>
      <maxMeshCount>9</maxMeshCount>
      <visualSizeRange>0.4~0.6</visualSizeRange>
      <topWindExposure>0.02</topWindExposure>
      <maxGrowthTemperature>75</maxGrowthTemperature>
    </plant>
  </ThingDef>
</Defs>
