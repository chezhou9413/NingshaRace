<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 文件职责：定义凝砂族沙漠巨坑入口建筑和进入地下沙岩洞穴所需的传送属性。 -->
  <ThingDef ParentName="BuildingBase">
    <defName>NingshaRace_DesertPitGate</defName>
    <label>沙漠巨坑</label>
    <description>一处被风沙磨蚀出的巨大坑洞，粗糙的沙岩洞壁通向更深处的地下洞室。</description>
    <thingClass>NingshaRaceLib.DesertPit.Buildings.Building_DesertPitGate</thingClass>
    <category>Building</category>
    <drawerType>MapMeshOnly</drawerType>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <selectable>true</selectable>
    <rotatable>false</rotatable>
    <size>(8,8)</size>
    <passability>Impassable</passability>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <holdsRoof>true</holdsRoof>
    <destroyable>false</destroyable>
    <useHitPoints>false</useHitPoints>
    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    <canOverlapZones>false</canOverlapZones>
    <filthLeaving>Filth_RubbleBuilding</filthLeaving>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <repairEffect>Repair</repairEffect>
    <building>
      <isEdifice>true</isEdifice>
      <deconstructible>false</deconstructible>
      <isTargetable>false</isTargetable>
      <isInert>true</isInert>
      <claimable>false</claimable>
      <expandHomeArea>false</expandHomeArea>
    </building>
    <comps>
      <li Class="CompProperties_LeaveFilthOnDestroyed">
        <filthDef>Filth_LooseGround</filthDef>
        <thickness>5</thickness>
      </li>
    </comps>
    <inspectorTabs>
      <li>ITab_ContentsMapPortal</li>
    </inspectorTabs>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>ClSemiTransparentCutout_ShaderPro</shaderType>
      <texPath>Things/Building/PitGate/PitGate</texPath>
      <drawSize>(10.4,10.4)</drawSize>
    </graphicData>
    <portal>
      <pocketMapGenerator>NingshaRace_DesertPitMap</pocketMapGenerator>
      <exitDef>CaveExit</exitDef>
      <pocketMapSize>140</pocketMapSize>
      <enteredLetterLabel>沙漠地下洞室</enteredLetterLabel>
      <enteredLetterText>坑底通向一片被沙岩包围的地下洞室。风化的砂砾、塌落的石柱和狭窄支洞在黑暗中延伸。</enteredLetterText>
      <enteredLetterDef>NeutralEvent</enteredLetterDef>
      <traverseSound>TraversePitGate</traverseSound>
    </portal>
    <statBases>
      <SellPriceFactor>0.7</SellPriceFactor>
      <Flammability>0</Flammability>
    </statBases>
  </ThingDef>
</Defs>
