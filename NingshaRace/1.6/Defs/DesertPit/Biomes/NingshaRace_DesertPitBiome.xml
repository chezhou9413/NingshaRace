<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 文件职责：定义沙漠巨坑口袋地图专用地下生态，避免普通地表生态访问无效世界格温度。 -->
  <BiomeDef ParentName="Biome_Underground">
    <defName>NingshaRace_DesertPitBiome</defName>
    <label>沙漠巨坑</label>
    <description>被风沙侵蚀的地下沙岩洞室，空气干燥而闷热。</description>
    <animalDensity>0</animalDensity>
    <plantDensity>0</plantDensity>
    <maxFishPopulation>0</maxFishPopulation>
    <wildAnimalsCanWanderInto>false</wildAnimalsCanWanderInto>
    <modExtensions>
      <li Class="NingshaRaceLib.DesertPit.Ecology.Config.DefModExtension_DesertPitEcology">
        <regrowthIntervalTicks>15000</regrowthIntervalTicks>
        <initialGrowthRange>0.15~0.35</initialGrowthRange>
        <habitatRadius>6</habitatRadius>
        <placementAttempts>120</placementAttempts>
        <plants>
          <li><plant>NingshaRace_DesertPitPlantA</plant><weight>13</weight></li>
          <li><plant>NingshaRace_DesertPitPlantB</plant><weight>13</weight></li>
          <li><plant>NingshaRace_DesertPitPlantC</plant><weight>13</weight></li>
          <li><plant>NingshaRace_DesertPitPlantD</plant><weight>13</weight></li>
          <li><plant>NingshaRace_DesertPitPlantE</plant><weight>13</weight></li>
          <li><plant>Glowstool</plant><weight>12</weight></li>
          <li><plant>Bryolux</plant><weight>13</weight></li>
          <li><plant>Agarilux</plant><weight>10</weight></li>
        </plants>
      </li>
      <li Class="NingshaRaceLib.DesertPit.Ecology.Config.DefModExtension_DesertPitFauna">
        <hiveCount>1</hiveCount>
        <animalCountRange>5~8</animalCountRange>
        <guaranteedAnimals>
          <li>Cobra</li>
          <li>Iguana</li>
          <li>Rat</li>
        </guaranteedAnimals>
        <animalPool>
          <li><pawnKind>Rat</pawnKind><weight>50</weight></li>
          <li><pawnKind>Iguana</pawnKind><weight>35</weight></li>
          <li><pawnKind>Cobra</pawnKind><weight>15</weight></li>
        </animalPool>
        <cappedAnimal>Cobra</cappedAnimal>
        <cappedAnimalCount>2</cappedAnimalCount>
        <entranceAvoidRadius>25</entranceAvoidRadius>
        <antNestAvoidRadius>24</antNestAvoidRadius>
        <hiveSceneRadius>8</hiveSceneRadius>
        <animalEntranceAvoidRadius>12</animalEntranceAvoidRadius>
        <animalSpacing>8</animalSpacing>
        <scanBatchSize>512</scanBatchSize>
      </li>
    </modExtensions>
  </BiomeDef>
</Defs>
