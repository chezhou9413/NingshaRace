    <AbPathWindows>/AssetBundles/ningsharace.ab</AbPathWindows>
    <AbPathMac>/AssetBundles/ningsharace_mac.ab</AbPathMac>
    <AbPathLinux>/AssetBundles/ningsharace.ab</AbPathLinux>
    <unityAssetMount>
      <li>
        <key>NingshaRace_SandThrowBurst</key>
        <value>/Prefabs/VFX/SandThrowBurst.prefab</value>
      </li>
      <li>
        <key>NingshaRace_PetrifyingSandwave</key>
        <value>/Prefabs/VFX/PetrifyingSandwave.prefab</value>
      </li>
      <li>
        <key>NingshaRace_PetrifyingSandHit</key>
