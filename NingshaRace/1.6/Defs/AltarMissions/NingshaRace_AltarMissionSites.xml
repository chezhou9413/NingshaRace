<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 文件职责：定义三类智慧之蛇任务使用的世界地点、SitePart、地图生成器与目标生成步骤。 -->
  <WorldObjectDef ParentName="Site"><defName>NingshaRace_AltarSmallRuinsSite</defName><label>小型凝砂遗迹</label><description>智慧之蛇指出的小型地下墓葬。</description><texture>NingshaRace/World/AltarMissionSite</texture><mapGenerator>NingshaRace_AltarSmallRuinsMap</mapGenerator></WorldObjectDef>
  <WorldObjectDef ParentName="Site"><defName>NingshaRace_AltarAntNestSite</defName><label>大型蚁巢</label><description>需要摧毁目标蚁穴的地下巢群。</description><texture>NingshaRace/World/AltarMissionSite</texture><mapGenerator>NingshaRace_AltarAntNestMap</mapGenerator></WorldObjectDef>
  <WorldObjectDef ParentName="Site"><defName>NingshaRace_AltarRescueSurfaceSite</defName><label>受困的凝砂族</label><description>一群凝砂族正在地表遭受侵蚀体围攻。</description><texture>NingshaRace/World/AltarMissionSite</texture><mapGenerator>Encounter</mapGenerator></WorldObjectDef>
  <WorldObjectDef ParentName="Site"><defName>NingshaRace_AltarRescueUndergroundSite</defName><label>受困的凝砂族</label><description>一群凝砂族正在地下遭受侵蚀体围攻。</description><texture>NingshaRace/World/AltarMissionSite</texture><mapGenerator>NingshaRace_AltarRescueUndergroundMap</mapGenerator></WorldObjectDef>

  <SitePartDef><defName>NingshaRace_AltarSmallRuinsPart</defName><label>小型凝砂遗迹</label><description>一座紧凑的地下凝砂墓葬，内部仍有主动威胁与固定遗物。</description><siteTexture>NingshaRace/World/AltarMissionSite</siteTexture><expandingIconTexture>NingshaRace/World/AltarMissionSite</expandingIconTexture><forceExitAndRemoveMapCountdownDurationDays>-1</forceExitAndRemoveMapCountdownDurationDays><disallowsAutomaticDetectionTimerStart>true</disallowsAutomaticDetectionTimerStart><considerEnteringAsAttack>true</considerEnteringAsAttack></SitePartDef>
  <SitePartDef><defName>NingshaRace_AltarAntNestPart</defName><label>清剿蚁巢</label><description>摧毁这里唯一的四级或五级蚁穴。</description><siteTexture>NingshaRace/World/AltarMissionSite</siteTexture><expandingIconTexture>NingshaRace/World/AltarMissionSite</expandingIconTexture><forceExitAndRemoveMapCountdownDurationDays>-1</forceExitAndRemoveMapCountdownDurationDays><disallowsAutomaticDetectionTimerStart>true</disallowsAutomaticDetectionTimerStart><considerEnteringAsAttack>true</considerEnteringAsAttack></SitePartDef>
  <SitePartDef><defName>NingshaRace_AltarRescuePart</defName><label>解救同胞</label><description>消灭指定侵蚀体并保证至少一名待救凝砂族存活。</description><siteTexture>NingshaRace/World/AltarMissionSite</siteTexture><expandingIconTexture>NingshaRace/World/AltarMissionSite</expandingIconTexture><forceExitAndRemoveMapCountdownDurationDays>-1</forceExitAndRemoveMapCountdownDurationDays><disallowsAutomaticDetectionTimerStart>true</disallowsAutomaticDetectionTimerStart><considerEnteringAsAttack>true</considerEnteringAsAttack><increasesPopulation>true</increasesPopulation></SitePartDef>

  <MapGeneratorDef><defName>NingshaRace_AltarSmallRuinsMap</defName><label>小型凝砂遗迹</label><isUnderground>true</isUnderground><ignoreAreaRevealedLetter>true</ignoreAreaRevealedLetter><disableCallAid>true</disableCallAid><roofDef>RoofRockThick</roofDef><defaultUnderGridTerrain>Sandstone_Rough</defaultUnderGridTerrain><genSteps><li>NingshaRace_AltarSmallRuinsLayout</li><li>NingshaRace_GiantTombFoundation</li><li>NingshaRace_GiantTombTemplates</li><li>NingshaRace_GiantTombRockFill</li><li>NingshaRace_AltarSmallRuinsEntry</li><li>NingshaRace_AltarSmallRuinsRewards</li><li>Fog</li></genSteps></MapGeneratorDef>
  <MapGeneratorDef><defName>NingshaRace_AltarAntNestMap</defName><label>大型地下蚁巢</label><isUnderground>true</isUnderground><ignoreAreaRevealedLetter>true</ignoreAreaRevealedLetter><disableCallAid>true</disableCallAid><forceCaves>true</forceCaves><roofDef>RoofRockThick</roofDef><genSteps><li>NingshaRace_DesertPitLayout</li><li>NingshaRace_DesertPitTerrain</li><li>NingshaRace_DesertPitHydrology</li><li>NingshaRace_AltarFixedAntNest</li><li>NingshaRace_AltarUndergroundStartSpot</li><li>Fog</li></genSteps></MapGeneratorDef>
  <MapGeneratorDef><defName>NingshaRace_AltarRescueUndergroundMap</defName><label>地下救援地点</label><isUnderground>true</isUnderground><ignoreAreaRevealedLetter>true</ignoreAreaRevealedLetter><disableCallAid>true</disableCallAid><forceCaves>true</forceCaves><roofDef>RoofRockThick</roofDef><genSteps><li>NingshaRace_DesertPitLayout</li><li>NingshaRace_DesertPitTerrain</li><li>NingshaRace_DesertPitHydrology</li><li>NingshaRace_AltarUndergroundStartSpot</li><li>Fog</li></genSteps></MapGeneratorDef>

  <GenStepDef><defName>NingshaRace_AltarSmallRuinsLayout</defName><order>100</order><genStep Class="NingshaRaceLib.GiantTomb.Generation.Steps.GenStep_GiantTombLayout"><layoutDef>NingshaRace_AltarSmallRuinsLayoutDef</layoutDef></genStep></GenStepDef>
  <GenStepDef><defName>NingshaRace_AltarSmallRuinsEntry</defName><order>450</order><genStep Class="NingshaRaceLib.AltarMissions.Map.GenStep_AltarSmallRuinsEntry" /></GenStepDef>
  <GenStepDef><defName>NingshaRace_AltarSmallRuinsRewards</defName><order>470</order><genStep Class="NingshaRaceLib.AltarMissions.Map.GenStep_AltarSmallRuinsRewards" /></GenStepDef>
  <GenStepDef><defName>NingshaRace_AltarFixedAntNest</defName><order>453.5</order><genStep Class="NingshaRaceLib.AltarMissions.Map.GenStep_AltarAntNest" /></GenStepDef>
  <GenStepDef><defName>NingshaRace_AltarUndergroundStartSpot</defName><order>790</order><genStep Class="NingshaRaceLib.AltarMissions.Map.GenStep_AltarUndergroundStartSpot" /></GenStepDef>
  <GenStepDef><defName>NingshaRace_AltarRescueTargets</defName><linkWithSite>NingshaRace_AltarRescuePart</linkWithSite><order>860</order><genStep Class="NingshaRaceLib.AltarMissions.Map.GenStep_AltarRescueTargets" /></GenStepDef>
</Defs>
