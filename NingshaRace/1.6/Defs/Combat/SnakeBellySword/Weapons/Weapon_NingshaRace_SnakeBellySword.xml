<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 文件职责：定义凝砂族蛇腹剑武器和五格扇形攻击参数。 -->

  <!-- Def 职责：提供凝砂族战士使用的五格扇形击退武器。 -->
  <ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
    <defName>NingshaRace_SnakeBellySword</defName>
    <label>蛇腹剑</label>
    <description>由多节锋刃构成的柔性长剑，是凝砂族法里斯们最常用的武器。挥动时刃节会沿攻击方向展开，同时扫击并击退前方的敌人，如同从手中延伸出的、舞动的长蛇。</description>
    <recipeMaker IsNull="True" />
    <smeltable>false</smeltable>
    <graphicData>
      <texPath>NingshaRace/Weapons/SnakeBellySword</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Cutout</shaderType>
      <drawSize>(1.12,1.12)</drawSize>
    </graphicData>
    <equippedAngleOffset>-45</equippedAngleOffset>
    <statBases>
      <Mass>1.6</Mass>
      <MarketValue>850</MarketValue>
      <MeleeWeapon_DamageMultiplier>1</MeleeWeapon_DamageMultiplier>
      <RangedWeapon_Cooldown>1.8</RangedWeapon_Cooldown>
    </statBases>
    <weaponTags Inherit="False">
      <li>NingshaRaceSnakeBellySword</li>
    </weaponTags>
    <tools Inherit="False" />
    <verbs Inherit="False">
      <li Class="NingshaRaceLib.Combat.SnakeBellySword.Verbs.VerbProperties_SnakeBellySword">
        <label>蛇腹剑攻击</label>
        <hasStandardCommand>true</hasStandardCommand>
        <isPrimary>true</isPrimary>
        <range>7</range>
        <warmupTime>0.2</warmupTime>
        <defaultCooldownTime>1.4</defaultCooldownTime>
        <meleeDamageDef>Cut</meleeDamageDef>
        <meleeDamageBaseAmount>15</meleeDamageBaseAmount>
        <meleeArmorPenetrationBase>0.21</meleeArmorPenetrationBase>
        <coneAngle>90</coneAngle>
        <knockbackCells>2</knockbackCells>
        <weaponHiddenTicks>42</weaponHiddenTicks>
        <effectScale>2.25</effectScale>
        <damageFactorMin>0.8</damageFactorMin>
        <damageFactorMax>1.2</damageFactorMax>
        <automaticArmorPenetrationFactor>0.015</automaticArmorPenetrationFactor>
        <ai_IsWeapon>true</ai_IsWeapon>
        <requireLineOfSight>true</requireLineOfSight>
        <targetParams>
          <canTargetLocations>false</canTargetLocations>
          <canTargetSelf>false</canTargetSelf>
          <canTargetPawns>true</canTargetPawns>
          <canTargetBuildings>true</canTargetBuildings>
          <canTargetItems>false</canTargetItems>
          <canTargetPlants>false</canTargetPlants>
          <canTargetFires>false</canTargetFires>
          <canTargetCorpses>false</canTargetCorpses>
          <mapObjectTargetsMustBeAutoAttackable>false</mapObjectTargetsMustBeAutoAttackable>
        </targetParams>
      </li>
    </verbs>
    <tools>
      <li>
        <label>剑柄</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>剑刃</label>
        <capacities>
          <li>Cut</li>
          <li>Stab</li>
        </capacities>
        <power>12</power>
        <armorPenetration>0.15</armorPenetration>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
  </ThingDef>
</Defs>
