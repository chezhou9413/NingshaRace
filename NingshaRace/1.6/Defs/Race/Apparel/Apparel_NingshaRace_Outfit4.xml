            <layerInvert>false</layerInvert>
            <flipWest>true</flipWest>
            <drawSize>1</drawSize>
            <scaleWithPawnDrawsize>true</scaleWithPawnDrawsize>
            <defaultOffset>Center</defaultOffset>
            <alignWithHead>false</alignWithHead>
            <conditions><BodyPart><bodyPart>Torso</bodyPart></BodyPart></conditions>
            <offsets>
              <south><layerOffset>-0.3</layerOffset><offset>(0, 0)</offset></south>
              <north><layerOffset>-0.292</layerOffset><offset>(0, 0)</offset></north>
              <east><layerOffset>-0.3</layerOffset><offset>(0, 0)</offset></east>
              <west><layerOffset>-0.3</layerOffset><offset>(0, 0)</offset></west>
            </offsets>
          </li>
          <li>
            <name>NingshaRace_Outfit4Chestwrap</name>
