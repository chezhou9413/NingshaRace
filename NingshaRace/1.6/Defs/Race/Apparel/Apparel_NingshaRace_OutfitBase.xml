<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 文件职责：提供凝砂族完整套装共用的物品、穿戴限制、属性和基础组件。 -->
  <ThingDef Name="NingshaRaceOutfitBase" Abstract="True">
    <generateCommonality>1</generateCommonality>
    <thingClass>Apparel</thingClass>
    <category>Item</category>
    <tickerType>Never</tickerType>
    <drawerType>MapMeshOnly</drawerType>
    <useHitPoints>true</useHitPoints>
    <selectable>true</selectable>
    <alwaysHaulable>true</alwaysHaulable>
    <altitudeLayer>Item</altitudeLayer>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <onGroundRandomRotateAngle>35</onGroundRandomRotateAngle>
    </graphicData>
    <apparel>
      <wornGraphicPath>NingshaRace/Pawns/Ningsha/Null/Null</wornGraphicPath>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
      <layers>
        <li>OnSkin</li>
        <li>Middle</li>
      </layers>
      <tags>
        <li>NingshaRaceCompleteOutfit</li>
      </tags>
    </apparel>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <DeteriorationRate>2</DeteriorationRate>
      <Mass>1.2</Mass>
      <ArmorRating_Sharp>0.08</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.04</ArmorRating_Blunt>
      <ArmorRating_Heat>0.08</ArmorRating_Heat>
      <EquipDelay>1.5</EquipDelay>
      <Insulation_Cold>4</Insulation_Cold>
      <Insulation_Heat>8</Insulation_Heat>
      <MarketValue>120</MarketValue>
    </statBases>
    <thingCategories>
      <li>Apparel</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li>
        <compClass>CompQuality</compClass>
      </li>
    </comps>
  </ThingDef>
</Defs>
