<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 文件职责：定义只由凝砂族战士概率生成的高阶战术斗篷及其身体附加层。 -->

  <!-- Def 职责：承载后层斗篷、主斗篷和围巾贴图，并作为可覆盖作战内衬的外层服装。 -->
  <ThingDef ParentName="NingshaRaceOutfitBase">
    <defName>NingshaRace_Apparel_AdvancedTacticalCloak</defName>
    <label>凝砂族高阶战术斗篷</label>
    <description>由幸存的第二王朝匠人们为后侵蚀时代凝砂族精锐法里斯设计的高阶战术斗篷，由后层披布、主斗篷与围巾构成。\n 尽管法里斯们一开始依然对自己的蛇鳞重甲念念不忘，但很快她们就发现，面对异象与侵蚀，这些斗篷明显更加实用。</description>
    <generateAllowChance>0</generateAllowChance>
    <graphicData>
      <texPath>NingshaRace/Apparel/Outfit3/Outfit3Item</texPath>
    </graphicData>
    <apparel Inherit="False">
      <wornGraphicPath>NingshaRace/Pawns/Ningsha/Null/Null</wornGraphicPath>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
      <layers>
        <li>Shell</li>
      </layers>
      <tags>
        <li>NingshaRaceWarriorTacticalCloak</li>
      </tags>
    </apparel>
    <comps>
      <li Class="ChezhouLib.comp.ApparelAddBodyAddonCompProperties">
        <targetRaces><li>NingshaRace</li></targetRaces>
        <bodyAddonDefs>
          <li>
            <name>NingshaRace_Outfit3CapeBack</name>
            <userCustomizable>false</userCustomizable>
            <path>NingshaRace/Apparel/Outfit3/Outfit3CapeBack</path>
            <colorChannel>raceskin</colorChannel>
            <colorOverrideOne>(255,255,255)</colorOverrideOne>
            <colorOverrideTwo>(255,255,255)</colorOverrideTwo>
            <shaderType>CutoutComplex</shaderType>
            <inFrontOfBody>true</inFrontOfBody>
            <layerInvert>false</layerInvert>
            <flipWest>true</flipWest>
            <drawSize>1</drawSize>
            <scaleWithPawnDrawsize>true</scaleWithPawnDrawsize>
            <defaultOffset>Center</defaultOffset>
            <alignWithHead>false</alignWithHead>
            <conditions><BodyPart><bodyPart>Torso</bodyPart></BodyPart></conditions>
            <offsets>
              <south><layerOffset>-0.31</layerOffset><offset>(0, 0)</offset></south>
              <north><layerOffset>-0.31</layerOffset><offset>(0, 0)</offset></north>
              <east><layerOffset>-0.31</layerOffset><offset>(0, 0)</offset></east>
              <west><layerOffset>-0.31</layerOffset><offset>(0, 0)</offset></west>
            </offsets>
          </li>
          <li>
            <name>NingshaRace_Outfit3Cape</name>
            <userCustomizable>false</userCustomizable>
            <path>NingshaRace/Apparel/Outfit3/Outfit3Cape</path>
            <colorChannel>raceskin</colorChannel>
            <colorOverrideOne>(255,255,255)</colorOverrideOne>
            <colorOverrideTwo>(255,255,255)</colorOverrideTwo>
            <shaderType>CutoutComplex</shaderType>
            <inFrontOfBody>true</inFrontOfBody>
            <layerInvert>false</layerInvert>
            <flipWest>true</flipWest>
            <drawSize>1</drawSize>
            <scaleWithPawnDrawsize>true</scaleWithPawnDrawsize>
            <defaultOffset>Center</defaultOffset>
            <alignWithHead>false</alignWithHead>
            <conditions><BodyPart><bodyPart>Torso</bodyPart></BodyPart></conditions>
            <offsets>
              <south><layerOffset>-0.301</layerOffset><offset>(0, 0)</offset></south>
              <north><layerOffset>-0.292</layerOffset><offset>(0, 0)</offset></north>
              <east><layerOffset>-0.3</layerOffset><offset>(0, 0)</offset></east>
              <west><layerOffset>-0.3</layerOffset><offset>(0, 0)</offset></west>
            </offsets>
          </li>
          <li>
            <name>NingshaRace_Outfit3Scarf</name>
            <userCustomizable>false</userCustomizable>
            <path>NingshaRace/Apparel/Outfit3/Outfit3Scarf</path>
            <colorChannel>raceskin</colorChannel>
            <colorOverrideOne>(255,255,255)</colorOverrideOne>
            <colorOverrideTwo>(255,255,255)</colorOverrideTwo>
            <shaderType>CutoutComplex</shaderType>
            <inFrontOfBody>true</inFrontOfBody>
            <layerInvert>false</layerInvert>
            <flipWest>true</flipWest>
            <drawSize>1</drawSize>
            <scaleWithPawnDrawsize>true</scaleWithPawnDrawsize>
            <defaultOffset>Center</defaultOffset>
            <alignWithHead>false</alignWithHead>
            <conditions><BodyPart><bodyPart>Torso</bodyPart></BodyPart></conditions>
            <offsets>
              <south><layerOffset>-0.28</layerOffset><offset>(0, 0)</offset></south>
              <north><layerOffset>-0.289</layerOffset><offset>(0, 0)</offset></north>
              <east><layerOffset>-0.29</layerOffset><offset>(0, 0)</offset></east>
              <west><layerOffset>-0.29</layerOffset><offset>(0, 0)</offset></west>
            </offsets>
          </li>
        </bodyAddonDefs>
      </li>
    </comps>
  </ThingDef>
</Defs>
