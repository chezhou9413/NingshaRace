<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 文件职责：定义凝砂族专用衣服和对应 BodyAddon 组件。 -->
  <!-- Def 职责：凝砂裹胸布，作为凝砂族贴身内衣显示在身体上。 -->
  <ThingDef>
    <defName>NingshaRace_Apparel_Chestwrap</defName>
    <label>凝砂裹胸布</label>
    <description>凝砂族贴身穿戴的简易裹胸布，粗砺布料贴合砂质肌理，遮护并固定胸部，通常是底层平民穿戴，如今则是缺少纺织能力的流浪者和聚落居民的日常着装。</description>
    <thingClass>Apparel</thingClass>
    <category>Item</category>
    <generateAllowChance>0</generateAllowChance>
    <tickerType>Never</tickerType>
    <drawerType>MapMeshOnly</drawerType>
    <useHitPoints>true</useHitPoints>
    <selectable>true</selectable>
    <alwaysHaulable>true</alwaysHaulable>
    <altitudeLayer>Item</altitudeLayer>
    <graphicData>
      <texPath>NingshaRace/Apparel/Chestwrap/Chestwrap_south</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <onGroundRandomRotateAngle>35</onGroundRandomRotateAngle>
    </graphicData>
    <apparel>
      <wornGraphicPath>NingshaRace/Pawns/Ningsha/Null/Null</wornGraphicPath>
      <developmentalStageFilter>Adult</developmentalStageFilter>
      <bodyPartGroups>
        <li>Torso</li>
      </bodyPartGroups>
      <layers>
        <li>NingshaRace_Underwear</li>
      </layers>
    </apparel>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <Flammability>0.8</Flammability>
      <DeteriorationRate>2</DeteriorationRate>
      <Mass>0.2</Mass>
      <ArmorRating_Sharp>0.01</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.01</ArmorRating_Blunt>
      <ArmorRating_Heat>0.02</ArmorRating_Heat>
      <EquipDelay>0.8</EquipDelay>
      <Insulation_Cold>1</Insulation_Cold>
      <Insulation_Heat>1</Insulation_Heat>
      <MarketValue>35</MarketValue>
    </statBases>
    <thingCategories>
      <li>Apparel</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li>
        <compClass>CompQuality</compClass>
      </li>
      <li Class="ChezhouLib.comp.ApparelAddBodyAddonCompProperties">
        <targetRaces>
          <li>NingshaRace</li>
        </targetRaces>
        <bodyAddonDefs>
          <li>
            <name>NingshaRace_Chestwrap</name>
            <userCustomizable>false</userCustomizable>
            <path>NingshaRace/Apparel/Chestwrap/Chestwrap</path>
            <colorChannel>raceskin</colorChannel>
            <colorOverrideOne>(255,255,255)</colorOverrideOne>
            <colorOverrideTwo>(255,255,255)</colorOverrideTwo>
            <shaderType>CutoutComplex</shaderType>
            <inFrontOfBody>true</inFrontOfBody>
            <layerInvert>false</layerInvert>
            <flipWest>true</flipWest>
            <angle>0</angle>
            <drawSize>1</drawSize>
            <scaleWithPawnDrawsize>true</scaleWithPawnDrawsize>
            <defaultOffset>Center</defaultOffset>
            <alignWithHead>false</alignWithHead>
            <conditions>
              <BodyPart>
                <bodyPart>Torso</bodyPart>
              </BodyPart>
            </conditions>
            <offsets>
              <south>
                <layerOffset>-0.294</layerOffset>
                <offset>(0, 0)</offset>
              </south>
              <north>
                <layerOffset>-0.294</layerOffset>
                <offset>(0, 0)</offset>
              </north>
              <east>
                <layerOffset>-0.294</layerOffset>
                <offset>(0, 0)</offset>
              </east>
              <west>
                <layerOffset>-0.294</layerOffset>
                <offset>(0, 0)</offset>
              </west>
            </offsets>
          </li>
        </bodyAddonDefs>
      </li>
    </comps>
  </ThingDef>

