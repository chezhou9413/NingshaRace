<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 文件职责：定义凝砂木乃伊可配置的毒砂利爪攻击动作。 -->
  <ToolCapacityDef>
    <defName>NingshaRace_GiantTombMummyClaw</defName>
  </ToolCapacityDef>

  <!-- 攻击职责：造成原版毒性抓伤，并在实际造成伤害后累计石化。 -->
  <ManeuverDef>
    <defName>NingshaRace_GiantTombMummyClaw</defName>
    <requiredCapacity>NingshaRace_GiantTombMummyClaw</requiredCapacity>
    <verb Class="NingshaRaceLib.GiantTomb.Pawns.Combat.VerbProperties_GiantTombMummyClaw">
      <meleeDamageDef>ScratchToxic</meleeDamageDef>
      <petrificationSeverity>0.2</petrificationSeverity>
    </verb>
    <logEntryDef>MeleeAttack</logEntryDef>
    <combatLogRulesHit>Maneuver_Scratch_MeleeHit</combatLogRulesHit>
    <combatLogRulesDeflect>Maneuver_Scratch_MeleeDeflect</combatLogRulesDeflect>
    <combatLogRulesMiss>Maneuver_Scratch_MeleeMiss</combatLogRulesMiss>
    <combatLogRulesDodge>Maneuver_Scratch_MeleeDodge</combatLogRulesDodge>
  </ManeuverDef>
</Defs>
