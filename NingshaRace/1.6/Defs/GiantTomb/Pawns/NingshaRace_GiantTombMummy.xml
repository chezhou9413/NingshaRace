<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 文件职责：定义巨型墓葬中不可驯服、无需饮食休息的木乃伊近战怪物。 -->
  <ThingDef ParentName="BaseInsect">
    <defName>NingshaRace_GiantTombMummy</defName>
    <label>凝砂木乃伊</label>
    <description>被古老砂葬仪式保留下来的初级异常实体。干枯利爪携带有毒砂尘，每次有效命中都会同时累积石化与毒素。</description>
    <uiIconScale>0.9</uiIconScale>
    <statBases>
      <MoveSpeed>3.2</MoveSpeed>
      <ArmorRating_Blunt>0.16</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.22</ArmorRating_Sharp>
      <ComfyTemperatureMin>-100</ComfyTemperatureMin>
      <ComfyTemperatureMax>100</ComfyTemperatureMax>
      <MarketValue>0</MarketValue>
      <LeatherAmount>0</LeatherAmount>
      <MeatAmount>0</MeatAmount>
      <Wildness>1</Wildness>
      <MinimumContainmentStrength>45</MinimumContainmentStrength>
    </statBases>
    <tools>
      <li>
        <label>干枯利爪</label>
        <capacities><li>NingshaRace_GiantTombMummyClaw</li></capacities>
        <power>14</power>
        <cooldownTime>2.2</cooldownTime>
      </li>
    </tools>
    <comps>
      <li Class="CompProperties_HoldingPlatformTarget">
        <baseEscapeIntervalMtbDays>30</baseEscapeIntervalMtbDays>
        <getsColdContainmentBonus>true</getsColdContainmentBonus>
      </li>
      <li Class="CompProperties_Studiable">
        <frequencyTicks>120000</frequencyTicks>
        <knowledgeCategory>Basic</knowledgeCategory>
        <minMonolithLevelForStudy>1</minMonolithLevelForStudy>
        <anomalyKnowledge>2</anomalyKnowledge>
        <requiresHoldingPlatform>true</requiresHoldingPlatform>
      </li>
      <li Class="CompProperties_ProducesBioferrite">
        <bioferriteDensity>1.5</bioferriteDensity>
      </li>
    </comps>
    <race>
      <thinkTreeMain>Animal</thinkTreeMain>
      <thinkTreeConstant>AnimalConstant</thinkTreeConstant>
      <body>Human</body>
      <baseBodySize>1</baseBodySize>
      <baseHungerRate>0</baseHungerRate>
      <baseHealthScale>1.3</baseHealthScale>
      <foodType>None</foodType>
      <needsRest>false</needsRest>
      <hasGenders>false</hasGenders>
      <hasCorpse>false</hasCorpse>
      <lifeExpectancy>1000</lifeExpectancy>
      <trainability>None</trainability>
      <lifeStageAges>
        <li>
          <def>AnimalAdult</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_BigInsect_Pain</soundWounded>
          <soundDeath>Pawn_BigInsect_Death</soundDeath>
          <soundCall>Pawn_BigInsect_Call</soundCall>
          <soundAngry>Pawn_BigInsect_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_Punch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_Punch_HitBuilding_Generic</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_Punch_Miss</soundMeleeMiss>
    </race>
  </ThingDef>

  <PawnKindDef ParentName="AnimalKindBase">
    <defName>NingshaRace_GiantTombMummyKind</defName>
    <label>凝砂木乃伊</label>
    <race>NingshaRace_GiantTombMummy</race>
    <combatPower>90</combatPower>
    <ecoSystemWeight>0</ecoSystemWeight>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/NingshaRace/GiantTomb/Mummy/Mummy</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.9</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>

  <!-- 图鉴职责：将凝砂木乃伊登记为解除迷雾时发现的原版初级异常。 -->
  <EntityCodexEntryDef>
    <defName>NingshaRace_GiantTombMummyCodex</defName>
    <label>凝砂木乃伊</label>
    <useDescriptionFrom>NingshaRace_GiantTombMummy</useDescriptionFrom>
    <category>Basic</category>
    <uiIconPath>UI/CodexEntries/Shambler</uiIconPath>
    <discoveryType>Unfog</discoveryType>
    <orderInCategory>900</orderInCategory>
    <linkedThings>
      <li>NingshaRace_GiantTombMummy</li>
    </linkedThings>
  </EntityCodexEntryDef>
</Defs>
