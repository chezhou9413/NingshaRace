<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 文件职责：定义凝砂族召唤沙傀能力及其沙傀标记状态。 -->
  <AbilityDef>
    <defName>NingshaRace_Ability_SummonSandGolem</defName>
    <label>召唤沙傀</label>
    <description>在沙地上召唤一个由砂砾塑成的自身映像。每名凝砂族只能维持一个沙傀，再次召唤会先收回旧沙傀。</description>
    <iconPath>UI/Abilities/SummonSandGolem</iconPath>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <showWhenDrafted>true</showWhenDrafted>
    <aiCanUse>false</aiCanUse>
    <ai_IsOffensive>false</ai_IsOffensive>
    <hostile>false</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <cooldownTicksRange>300</cooldownTicksRange>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>24</range>
      <warmupTime>0.35</warmupTime>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="NingshaRaceLib.Abilities.CompProperties_AbilitySummonSandGolem" />
    </comps>
  </AbilityDef>

  <HediffDef>
    <defName>NingshaRace_SandGolemMarker</defName>
    <label>沙傀</label>
    <description>由凝砂术临时塑成的沙偶，没有常规需求、关系和疲劳。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <scenarioCanAdd>false</scenarioCanAdd>
    <isBad>false</isBad>
    <stages>
      <li>
        <disablesNeeds>
          <li>Mood</li>
          <li>Food</li>
          <li>Rest</li>
          <li>Joy</li>
          <li>Beauty</li>
          <li>Comfort</li>
          <li>Outdoors</li>
          <li>Indoors</li>
          <li>RoomSize</li>
          <li>Learning</li>
          <li>Play</li>
          <li MayRequire="Ludeon.RimWorld.Biotech">MechEnergy</li>
        </disablesNeeds>
      </li>
    </stages>
    <comps>
      <li Class="NingshaRaceLib.SandGolem.HediffCompProperties_SandGolemMarker" />
    </comps>
  </HediffDef>
</Defs>
