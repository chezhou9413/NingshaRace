<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--普通巨坑与地下开局共用 v14 洞穴基座及沿水系展开的分区生态。-->
  <MapGeneratorDef>
    <defName>NingshaRace_DesertPitMap</defName>
    <label>沙漠巨坑</label>
    <isUnderground>true</isUnderground>
    <ignoreAreaRevealedLetter>true</ignoreAreaRevealedLetter>
    <disableCallAid>true</disableCallAid>
    <forceCaves>true</forceCaves>
    <roofDef>NingshaRace_DesertPitStableRockRoof</roofDef>
    <pocketMapProperties>
      <biome>NingshaRace_DesertPitBiome</biome>
      <temperature>24</temperature>
      <tileMutators />
    </pocketMapProperties>
    <genSteps>
      <li>NingshaRace_DesertPitCaveBase</li>
      <li>NingshaRace_DesertPitExit</li>
      <li>NingshaRace_DesertPitRegionalEcology</li>
      <li>Fog</li>
    </genSteps>
  </MapGeneratorDef>

  <!-- Def 职责：生成与地表入口相连的地下家园，成员与物资在地图完成后直接安置。 -->
  <MapGeneratorDef>
    <defName>NingshaRace_DesertPitStartingMap</defName>
    <label>沙漠巨坑内部</label>
    <isUnderground>true</isUnderground>
    <ignoreAreaRevealedLetter>true</ignoreAreaRevealedLetter>
    <disableCallAid>true</disableCallAid>
    <forceCaves>true</forceCaves>
    <validScenarioMap>false</validScenarioMap>
    <roofDef>NingshaRace_DesertPitStableRockRoof</roofDef>
    <pocketMapProperties>
      <biome>NingshaRace_DesertPitBiome</biome>
      <temperature>24</temperature>
      <tileMutators />
    </pocketMapProperties>
    <genSteps>
      <li>NingshaRace_DesertPitCaveBase</li>
      <li>NingshaRace_DesertPitExit</li>
      <li>NingshaRace_DesertPitRegionalEcology</li>
      <li>Fog</li>
    </genSteps>
  </MapGeneratorDef>
</Defs>
