<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--蚁狮保留虫类身体和肉类，使用独立伏击组件，不继承普通虫群的休眠和觅食组件。-->
  <ThingDef ParentName="BaseInsect">
    <defName>NingshaRace_Antlion</defName>
    <label>蚁狮</label>
    <description>潜藏在松软沙层中的凶猛猎手。地面偶尔扬起的细沙是它留下的征兆。人或动物靠近时，它会突然钻出并迅速扑咬；失去猎物后，它便寻找附近的沙地重新藏身。</description>
    <uiIconScale>1.35</uiIconScale>
    <statBases>
      <MoveSpeed>3.4</MoveSpeed>
      <ArmorRating_Sharp>0.18</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.10</ArmorRating_Blunt>
      <ComfyTemperatureMin>-20</ComfyTemperatureMin>
      <MarketValue>200</MarketValue>
      <LeatherAmount>0</LeatherAmount>
      <Wildness>1</Wildness>
    </statBases>
    <tools>
      <li>
        <label>颚齿</label>
        <capacities><li>Bite</li></capacities>
        <power>12</power>
        <cooldownTime>1.8</cooldownTime>
        <linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
      </li>
    </tools>
    <race>
      <renderTree>NingshaRace_AntlionRenderTree</renderTree>
      <thinkTreeMain>NingshaRace_Antlion</thinkTreeMain>
      <thinkTreeConstant>NingshaRace_AntlionConstant</thinkTreeConstant>
      <body>BeetleLike</body>
      <baseBodySize>1.2</baseBodySize>
      <baseHealthScale>1.6</baseHealthScale>
      <foodType>None</foodType>
      <baseHungerRate>0</baseHungerRate>
      <hasGenders>false</hasGenders>
      <canBecomeShambler>false</canBecomeShambler>
      <manhunterOnDamageChance>0</manhunterOnDamageChance>
      <useMeatFrom>Megaspider</useMeatFrom>
      <lifeExpectancy>12</lifeExpectancy>
      <trainability>None</trainability>
      <lifeStageAges>
        <li>
          <def>EusocialInsectAdult</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_Spelopede_Pain</soundWounded>
          <soundDeath>Pawn_Spelopede_Death</soundDeath>
          <soundAngry>Pawn_Spelopede_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <comps Inherit="False">
      <li Class="NingshaRaceLib.DesertPit.Antlion.Components.CompProperties_AntlionAmbush">
        <!--半径单位为格，采用圆形距离；追击边界从每次出土点计算。-->
        <triggerRadius>3</triggerRadius>
        <chaseRadius>12</chaseRadius>
        <burstMultiplier>1.7</burstMultiplier>
        <!--六十更新单位约为正常速度下的一秒；加速从出土动画完成后开始。-->
        <burstTicks>180</burstTicks>
        <emergeTicks>18</emergeTicks>
        <submergeTicks>30</submergeTicks>
        <sandSearchRadius>12</sandSearchRadius>
        <scanIntervalTicks>10</scanIntervalTicks>
        <unreachableTicks>120</unreachableTicks>
        <sandRetryTicks>120</sandRetryTicks>
        <rearmTicks>120</rearmTicks>
        <!--仅列出的地表允许下潜；铺设地板后不再属于沙地。-->
        <burrowTerrains><li>Sand</li><li>SoftSand</li></burrowTerrains>
      </li>
    </comps>
  </ThingDef>
  <PawnKindDef ParentName="AnimalKindBase">
    <defName>NingshaRace_AntlionKind</defName>
    <label>蚁狮</label>
    <race>NingshaRace_Antlion</race>
    <defaultFactionDef>NingshaRace_AntlionFaction</defaultFactionDef>
    <combatPower>120</combatPower>
    <ecoSystemWeight>0</ecoSystemWeight>
    <canArriveManhunter>false</canArriveManhunter>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/NingshaRace/DesertPit/Antlion/Antlion</texPath>
          <drawSize>1.8</drawSize>
          <allowFlip>true</allowFlip>
        </bodyGraphicData>
        <!--干枯尸体复用轮廓，由原版虫类尸体颜色处理，不请求缺失的骨架贴图。-->
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/NingshaRace/DesertPit/Antlion/Antlion</texPath>
          <drawSize>1.8</drawSize>
          <allowFlip>true</allowFlip>
        </dessicatedBodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>
  <!--地下实体仅持有原生物与局部感知，不能选择、受伤或阻挡通行。-->
  <ThingDef ParentName="EtherealThingBase">
    <defName>NingshaRace_AntlionBurrow</defName>
    <label>细沙扰动</label>
    <thingClass>NingshaRaceLib.DesertPit.Antlion.Holders.AntlionBurrow</thingClass>
    <tickerType>Normal</tickerType>
    <selectable>false</selectable>
    <drawGUIOverlay>false</drawGUIOverlay>
    <passability>Standable</passability>
  </ThingDef>
</Defs>
