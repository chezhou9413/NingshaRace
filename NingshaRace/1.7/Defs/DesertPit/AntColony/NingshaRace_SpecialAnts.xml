<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="NingshaRace_AntBase">
    <defName>NingshaRace_DesertPitBreakerAnt</defName>
    <label>破军蚁</label>
    <description>厚重甲壳和强劲颚爪使它能蓄力冲锋，沿途敌我都会被撞伤。</description>
    <uiIconScale>1.1</uiIconScale>
    <statBases>
      <MoveSpeed>3.8</MoveSpeed>
      <ArmorRating_Blunt>0.3</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.42</ArmorRating_Sharp>
      <ComfyTemperatureMin>-20</ComfyTemperatureMin>
      <MarketValue>210</MarketValue>
      <LeatherAmount>0</LeatherAmount>
      <Wildness>1</Wildness>
    </statBases>
    <tools>
      <li>
        <label>战斗颚</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>15</power>
        <cooldownTime>2.2</cooldownTime>
        <linkedBodyPartsGroup>HeadClaw</linkedBodyPartsGroup>
      </li>
      <!--头爪或口器失效时仍可进行低伤害头撞，沿用原版昆虫的头部备用攻击规则。-->
      <li>
        <label>头部撞击</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>6</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.1</chanceFactor>
      </li>
    </tools>
    <race>
      <body>NingshaRace_BreakerAntBody</body>
      <baseBodySize>1.8</baseBodySize>
      <baseHungerRate>0.36</baseHungerRate>
      <baseHealthScale>3.3</baseHealthScale>
      <lifeExpectancy>7</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>EusocialInsectAdult</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_BigInsect_Pain</soundWounded>
          <soundDeath>Pawn_BigInsect_Death</soundDeath>
          <soundCall>Pawn_BigInsect_Call</soundCall>
          <soundAngry>Pawn_BigInsect_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
    </race>
    <comps>
      <li Class="NingshaRaceLib.DesertPit.AntColony.Components.CompProperties_DesertPitAntMember">
        <caste>Breaker</caste>
      </li>
    </comps>
  </ThingDef>
