<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--吐酸蚁拥有贴身颚齿和原生远程喷酸；侧面原图朝左，由专用渲染树调整两侧网格镜像。-->
  <ThingDef ParentName="BaseInsect">
    <defName>NingshaRace_DesertPitAcidAnt</defName>
    <label>吐酸蚁</label>
    <description>腹部透出荧绿光泽的洞穴蚂蚁。它会喷出黏稠酸液灼伤远处敌人，使其短暂行动迟缓；敌人靠近时则用颚齿还击。</description>
    <statBases>
      <MoveSpeed>3.6</MoveSpeed>
      <ArmorRating_Blunt>0.15</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.2</ArmorRating_Sharp>
      <ComfyTemperatureMin>-20</ComfyTemperatureMin>
      <MarketValue>260</MarketValue>
      <LeatherAmount>0</LeatherAmount>
      <Wildness>1</Wildness>
      <ShootingAccuracyPawn>0.85</ShootingAccuracyPawn>
    </statBases>
    <tools>
      <li>
        <label>颚齿</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>8</power>
        <cooldownTime>2.2</cooldownTime>
        <linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
      </li>
      <!--头爪或口器失效时仍可进行低伤害头撞，沿用原版昆虫的头部备用攻击规则。-->
      <li>
        <label>头部撞击</label>
        <capacities><li>Blunt</li></capacities>
        <power>3</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.1</chanceFactor>
      </li>
    </tools>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <label>喷酸</label>
        <hasStandardCommand>true</hasStandardCommand>
        <warmupTime>0.6</warmupTime>
        <defaultCooldownTime>1.12</defaultCooldownTime>
        <range>18</range>
        <minRange>1.5</minRange>
        <defaultProjectile>NingshaRace_AntAcidProjectile</defaultProjectile>
        <soundCast>Pawn_Spelopede_Angry</soundCast>
        <muzzleFlashScale>0</muzzleFlashScale>
        <accuracyTouch>0.9</accuracyTouch>
        <accuracyShort>0.8</accuracyShort>
        <accuracyMedium>0.65</accuracyMedium>
        <accuracyLong>0.5</accuracyLong>
      </li>
    </verbs>
    <race>
      <renderTree>NingshaRace_AcidAntRenderTree</renderTree>
      <thinkTreeMain>NingshaRace_DesertPitAnt</thinkTreeMain>
      <thinkTreeConstant>NingshaRace_DesertPitAntConstant</thinkTreeConstant>
      <body>BeetleLike</body>
      <baseBodySize>1.1</baseBodySize>
      <baseHungerRate>0.22</baseHungerRate>
      <baseHealthScale>1.8</baseHealthScale>
      <useMeatFrom>Megaspider</useMeatFrom>
      <lifeExpectancy>7</lifeExpectancy>
      <trainability>None</trainability>
      <lifeStageAges>
        <li>
          <def>EusocialInsectAdult</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_Spelopede_Pain</soundWounded>
          <soundDeath>Pawn_Spelopede_Death</soundDeath>
          <soundCall>Pawn_Spelopede_Call</soundCall>
          <soundAngry>Pawn_Spelopede_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <comps>
      <li Class="NingshaRaceLib.DesertPit.AntColony.Components.CompProperties_DesertPitAntMember">
        <caste>Acid</caste>
      </li>
    </comps>
  </ThingDef>
  <PawnKindDef ParentName="InsectKindBase">
    <defName>NingshaRace_DesertPitAcidAntKind</defName>
    <label>吐酸蚁</label>
    <race>NingshaRace_DesertPitAcidAnt</race>
    <combatPower>140</combatPower>
    <ecoSystemWeight>0</ecoSystemWeight>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/NingshaRace/DesertPit/AntColony/AcidAnt/AcidAnt</texPath>
          <drawSize>1.9</drawSize>
          <allowFlip>true</allowFlip>
        </bodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>
</Defs>
