<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--生态建筑共用轻量表现；驱蚁桩与蚁群建筑各用独立透明贴图。-->
  <ThingDef ParentName="BuildingBase" Name="NingshaRace_AntHabitatBase" Abstract="True">
    <category>Building</category>
    <tickerType>Normal</tickerType>
    <drawerType>MapMeshOnly</drawerType>
    <altitudeLayer>Building</altitudeLayer>
    <selectable>true</selectable>
    <rotatable>false</rotatable>
    <useHitPoints>true</useHitPoints>
    <destroyable>true</destroyable>
    <passability>PassThroughOnly</passability>
    <pathCost>20</pathCost>
    <fillPercent>0.35</fillPercent>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <statBases>
      <MaxHitPoints>350</MaxHitPoints>
      <Flammability>0.25</Flammability>
      <Mass>35</Mass>
      <WorkToBuild>300</WorkToBuild>
    </statBases>
    <building>
      <isEdifice>false</isEdifice>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
      <expandHomeArea>false</expandHomeArea>
      <neverBuildable>true</neverBuildable>
    </building>
  </ThingDef>
  <ThingDef ParentName="NingshaRace_AntHabitatBase">
    <defName>NingshaRace_AntRepellent</defName>
    <label>驱蚁桩</label>
    <description>菌类和植物附着在树桩状的高大石块上，散发出蚂蚁厌恶的气味。气味浓郁时，附近物资不会被工蚁收集，但蚂蚁仍会经过和攻击。每六小时有一成概率散去气味，持续到下个周期。可以占领并搬走，无法自行建造。</description>
    <thingClass>NingshaRaceLib.DesertPit.Ecology.Habitats.Building_AntRepellent</thingClass>
    <size>(1,1)</size>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/NingshaRace/DesertPit/Ecology/AntRepellent</texPath>
      <drawSize>(2.2,2.2)</drawSize>
    </graphicData>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <building>
      <claimable>true</claimable>
    </building>
    <modExtensions>
      <li Class="NingshaRaceLib.DesertPit.Ecology.Habitats.DefModExtension_AntRepellent">
        <radius>12</radius>
        <cycleTicks>15000</cycleTicks>
        <failureChance>0.06</failureChance>
      </li>
    </modExtensions>
  </ThingDef>
</Defs>
