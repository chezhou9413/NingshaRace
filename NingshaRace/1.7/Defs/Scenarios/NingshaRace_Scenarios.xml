<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 文件职责：定义凝砂族专属的沙漠地底殖民开局。 -->

  <!-- Def 职责：提供三名凝砂族以中世纪科技和部落物资、直接在随机沙漠地下开始的固定场景。 -->
  <ScenarioDef ParentName="ScenarioBase">
    <defName>NingshaRace_DesertPitStart</defName>
    <label>深砂遗民</label>
    <description>你们是三名离开旧聚落的凝砂族。地表的酷热与追猎迫使队伍再次潜入沙海之下，在一座陌生巨坑中建立新家。这里没有可以选择的安稳落脚点，命运只会把你们送往世界上的某片沙漠。

你们保留着中世纪水平的技艺，只带着简陋衣物、木棒、钢制短矛和短弓，以及部落常用的干肉饼、草药和建材。其余武器与三只家养动物也随队进入地下。离洞绳附近的驱蚁桩能在正常运转时掩盖物资气味，但不能阻挡蚂蚁通行或攻击。巨坑拥有稳定的厚岩顶、独特生态与有限资源，也隔绝了太阳能。</description>
    <scenario>
      <summary>三名凝砂族携带部落物资与基础装备，以中世纪科技在随机沙漠的地下巨坑中重建家园。</summary>
      <playerFaction>
        <factionDef>NingshaRace_DesertPitPlayerFaction</factionDef>
      </playerFaction>
      <parts>
        <li Class="NingshaRaceLib.Scenarios.Parts.ScenPart_ForcedDesertPitStart">
          <def>NingshaRace_ForcedDesertPitStart</def>
          <mapGenerator>Base_Player</mapGenerator>
          <layerDef>Surface</layerDef>
          <visible>false</visible>
        </li>

        <li Class="NingshaRaceLib.Scenarios.Parts.ScenPart_NingshaStartingPawns">
          <def>NingshaRace_StartingPawns</def>
          <pawnChoiceCount>8</pawnChoiceCount>
          <kindCounts>
            <li>
              <kindDef>NingshaRace_DesertPitStarter</kindDef>
              <count>3</count>
              <requiredAtStart>true</requiredAtStart>
            </li>
          </kindCounts>
        </li>

        <li Class="NingshaRaceLib.Scenarios.Parts.ScenPart_NingshaUndergroundArrival">
          <def>NingshaRace_UndergroundArrival</def>
          <visible>false</visible>
        </li>

        <li Class="NingshaRaceLib.Scenarios.Parts.ScenPart_NingshaStartingEquipment">
          <def>NingshaRace_StartingEquipment</def>
          <weapons>
            <li>
              <weaponDef>MeleeWeapon_Club</weaponDef>
              <stuff>WoodLog</stuff>
            </li>
            <li>
              <weaponDef>MeleeWeapon_Ikwa</weaponDef>
              <stuff>Steel</stuff>
            </li>
            <li>
              <weaponDef>Bow_Short</weaponDef>
            </li>
          </weapons>
        </li>

        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Pemmican</thingDef>
          <count>400</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MedicineHerbal</thingDef>
          <count>20</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Silver</thingDef>
          <count>200</count>
        </li>
        <!-- 投放职责：木材与其余部落物资统一安置在地下安全区，不使用只处理地表的散落步骤。 -->
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>WoodLog</thingDef>
          <count>500</count>
        </li>
        <!-- 投放职责：原版部落六件武器中的三件已直接装备，余下三件只在地上生成一次。 -->
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MeleeWeapon_Knife</thingDef>
          <stuff>Jade</stuff>
          <count>1</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Bow_Short</thingDef>
          <count>1</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Pila</thingDef>
          <count>1</count>
        </li>
        <li Class="ScenPart_StartingAnimal">
          <def>StartingAnimal</def>
          <count>3</count>
          <bondToRandomPlayerPawnChance>1.0</bondToRandomPlayerPawnChance>
        </li>
      </parts>
    </scenario>
  </ScenarioDef>
</Defs>
