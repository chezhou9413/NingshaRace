      </li>
      <li Class="NingshaRaceLib.Zhenni.Bladebearer.CompProperties_BladebearerPhaseStep">
        <cooldownTicks>300</cooldownTicks>
        <arrivalTicks>30</arrivalTicks>
        <minRange>3.5</minRange>
        <maxRange>12</maxRange>
        <departureSeconds>0.48</departureSeconds>
        <deathSeconds>1.25</deathSeconds>
      </li>
      <li Class="CompProperties_HoldingPlatformTarget">
