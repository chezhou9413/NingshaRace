<Defs>
  <!-- 持斧者与拥刀者是独立实体，共享震尼系列的瞬移和分层渲染。 -->
  <ThingDef ParentName="BasePawn">
    <defName>NingshaRace_Zhenni_Axebearer_Pawn</defName>
    <label>震尼持斧者</label>
    <description>幽焰托起的古老甲胄，握持一柄沉重的长柄战斧。震尼持斧者能够在紫焰中消散，重新聚合在敌人身旁。它的出招较慢，却会以大幅度的劈斩撕开防御。斧刃蓄势时浮现的紫色星光，是避开下一次重击的短暂机会。\n\n倒地后可被收容研究；死亡时甲胄和战斧一同消散，不留下尸体或可拾取的装备。</description>
    <uiIconPath>UI/CodexEntries/NingshaRace/Zhenni/Axebearer/Axebearer</uiIconPath>
    <hiddenWhileUndiscovered>true</hiddenWhileUndiscovered>
    <tradeability>None</tradeability>
