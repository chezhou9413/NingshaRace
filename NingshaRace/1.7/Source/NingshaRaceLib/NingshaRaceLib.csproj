<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>NingshaRaceLib</AssemblyName>
    <RootNamespace>NingshaRaceLib</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../1.6/Source/NingshaRaceLib/**/*.cs" Exclude="../../../1.6/Source/NingshaRaceLib/obj/**/*.cs;../../../1.6/Source/NingshaRaceLib/bin/**/*.cs" />
    <Compile Include="**/*.cs" Exclude="obj/**/*.cs;bin/**/*.cs" />
    <Compile Remove="../../../1.6/Source/NingshaRaceLib/Zhenni/Bladebearer/Rendering/Bloom/**/*.cs;../../../1.6/Source/NingshaRaceLib/Zhenni/Bladebearer/Editor/BladebearerBloomPreview.cs" />
    <Compile Remove="../../../1.6/Source/NingshaRaceLib/Core/Effects/*.cs;../../../1.6/Source/NingshaRaceLib/Erosion/Effects/ErosionHeadEffectManager.cs;../../../1.6/Source/NingshaRaceLib/Erosion/Effects/ErosionHeadEffectFollower.cs;../../../1.6/Source/NingshaRaceLib/Combat/SandBottle/Utility/SandBottleParticlePresentation.cs;../../../1.6/Source/NingshaRaceLib/Combat/SandBottle/Utility/SandBottleParticleMaterials.cs" />
    <Reference Include="ChezhouLib" HintPath="$(ChezhouLibDir)/1.7/Assemblies/ChezhouLib.dll" />
    <Reference Include="ChezhouLib.RimUnity" HintPath="$(ChezhouLibDir)/1.7/RimUnityCompat/Assemblies/ChezhouLib.RimUnity.dll" />
    <Reference Include="RimUnity.Core" HintPath="$(RimUnityDir)/1.7/Assemblies/RimUnity.Core.dll" />
    <Reference Include="RimUnity" HintPath="$(RimUnityDir)/1.7/Assemblies/RimUnity.dll" />
    <Reference Include="AlienRace" HintPath="$(ChezhouLibDir)/Source/.build/references/1.7/AlienRace.dll" />
    <Reference Include="RimWorld" HintPath="$(RimWorldDir)/RimWorld.dll" />
    <Reference Include="Brutal.Vulkan" HintPath="$(RimWorldDir)/Brutal.Vulkan.dll" />
    <Reference Include="Brutal.Vulkan.Abstractions" HintPath="$(RimWorldDir)/Brutal.Vulkan.Abstractions.dll" />
    <Reference Include="Brutal.Core.Common" HintPath="$(RimWorldDir)/Brutal.Core.Common.dll" />
    <Reference Include="Brutal.Core.Numerics" HintPath="$(RimWorldDir)/Brutal.Core.Numerics.dll" />
    <Reference Include="Brutal.Core.Memory" HintPath="$(RimWorldDir)/Brutal.Core.Memory.dll" />
  </ItemGroup>
</Project>
